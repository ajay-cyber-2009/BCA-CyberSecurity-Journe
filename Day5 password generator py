import random
import string

print("=== AJAY's PASSWORD GENERATOR - Day 5 ===")

length = int(input("Password length entha kavali? (Ex: 8, 12): "))

letters = string.ascii_letters
digits = string.digits
symbols = "!@#$%&*"

all_chars = letters + digits + symbols

password = ""
for i in range(length):
    password = password + random.choice(all_chars)

print(f"\nNee Strong Password: {password}")
print("Dini evaru hack cheyaleru! 🔐")
